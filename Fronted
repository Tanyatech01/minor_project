<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Blockchain Clone</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
    }
    nav {
      display: flex;
      justify-content: space-between;
      background: #0a0a23;
      color: white;
      padding: 15px 30px;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 20px;
    }

    nav ul li {
      cursor: pointer;
    }

    button {
      padding: 8px 15px;
      margin-left: 10px;
      border: none;
      cursor: pointer;
      border-radius: 5px;
    }

    .login-btn { background: #00bcd4; color: white; }
    .signup-btn { background: #4caf50; color: white; }

   
    section {
      padding: 60px;
      text-align: center;
    }

    #home { background: #f5f5f5; }
    #blockchain { background: #e3f2fd; }
    #about { background: #fff3e0; }

  
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.6);
      justify-content: center;
      align-items: center;
    }

    .modal-content {
      background: white;
      padding: 30px;
      border-radius: 10px;
      width: 300px;
      text-align: center;
    }

    .modal input {
      width: 90%;
      padding: 8px;
      margin: 10px 0;
    }

    .close {
      float: right;
      cursor: pointer;
      font-size: 18px;
    }

  
    footer {
      background: #0a0a23;
      color: white;
      text-align: center;
      padding: 20px;
    }
  </style>
</head>
<body>

<nav>
  <h2>Blockchain</h2>
  <ul>
    <li onclick="scrollToSection('home')">Home</li>
    <li onclick="scrollToSection('blockchain')">Blockchain</li>
    <li onclick="scrollToSection('about')">About</li>
  </ul>
  <div>
    <button class="login-btn" onclick="openModal('loginModal')">Login</button>
    <button class="signup-btn" onclick="openModal('signupModal')">Sign Up</button>
  </div>
</nav>

<section id="home">
  <h1>Welcome to Blockchain World</h1>
  <p>Secure. Transparent. Decentralized.</p>
</section>

<section id="blockchain">
  <h1>What is Blockchain?</h1>
  <p>A blockchain is a distributed ledger technology that ensures data security and transparency.</p>
</section>

<section id="about">
  <h1>About Us</h1>
  <p>We are building innovative blockchain-based solutions.</p>
</section>

<div class="modal" id="loginModal">
  <div class="modal-content">
    <span class="close" onclick="closeModal('loginModal')">&times;</span>
    <h2>Login</h2>
    <input type="text" placeholder="Username"><br>
    <input type="password" placeholder="Password"><br>
    <button>Login</button>
  </div>
</div>

<!-- Signup Modal -->
<div class="modal" id="signupModal">
  <div class="modal-content">
    <span class="close" onclick="closeModal('signupModal')">&times;</span>
    <h2>Sign Up</h2>
    <input type="text" placeholder="Username"><br>
    <input type="email" placeholder="Email"><br>
    <input type="password" placeholder="Password"><br>
    <button>Sign Up</button>
  </div>
</div>

<!-- Footer -->
<footer>
  <p>Team Members: Suhani | Sukriti | Sneha | Tanya</p>
</footer>

<script>
  function scrollToSection(id) {
    document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
  }

  function openModal(id) {
    document.getElementById(id).style.display = 'flex';
  }

  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }

  // Close modal when clicking outside
  window.onclick = function(event) {
    let loginModal = document.getElementById('loginModal');
    let signupModal = document.getElementById('signupModal');

    if (event.target === loginModal) {
      loginModal.style.display = "none";
    }
    if (event.target === signupModal) {
      signupModal.style.display = "none";
    }
  }
</script>

</body>
</html>
